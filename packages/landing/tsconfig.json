{
    "compilerOptions": {
        "lib": ["es2020", "dom"],
        "noImplicitAny": false,
        "noImplicitThis": true,
        "strictNullChecks": false,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "noUnusedLocals": false,
        "allowSyntheticDefaultImports": true,
        "jsx": "react",
        "baseUrl": ".",
        "paths": {
            "@/components/ui/*": ["../_shared/src/components/ui/*"],
            "@/hooks/*": ["../_shared/src/hooks/*"],
            "@/lib/*": ["../_shared/src/lib/*"],
            "@/*": ["./src/_common/*"]
        }
    },
    "include": ["./src", "../_shared/src"]
}